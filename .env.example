# Paths are relative to the project folder unless absolute.
BOOK_DOWNLOAD_DIR=downloads

# Optional for search and download. All mail must use the configured Kindle recipient.
KINDLE_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional sender override if the SMTP provider authorizes it.
SMTP_FROM=
# Raw attachment bytes. Choose a limit your SMTP provider can accept after MIME encoding.
KINDLE_MAX_BYTES=18000000
